{
  "name": "@apps/notification-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon -L --watch src --exec ts-node src/server.ts",
    "dev:debug": "nodemon -L --watch src --exec \"node --inspect=0.0.0.0:9229 -r ts-node/register src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migration:create": "sequelize-cli migration:generate --name",
    "migration:up": "sequelize-cli db:migrate",
    "migration:down": "sequelize-cli db:migrate:undo",
    "migration:status": "sequelize-cli db:migrate:status"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.3.6"
  }
}
